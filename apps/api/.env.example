PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Set to the exact number of trusted reverse proxies in your deployment; 0 locally.
TRUST_PROXY_HOPS=0

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

SUPABASE_URL=
# Backend-only secret key. Legacy service_role keys also work here.
SUPABASE_SECRET_KEY=

# Used only for vector embeddings; Groq remains the chat LLM.
OPENAI_API_KEY=
# Private bearer token for POST /api/chatbot/documents. Never expose in React.
CHATBOT_INGEST_TOKEN=
